{
  "name": "window-text-reader",
  "version": "1.0.0",
  "description": "后台自动监控窗口文本变化并通过 TTS 朗读的工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.spllm.window-text-reader",
    "productName": "窗口文本朗读器",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "窗口文本朗读器"
    },
    "asar": true,
    "asarUnpack": [
      "scripts/**/*.ps1"
    ],
    "extraResources": [
      "scripts/**/*.ps1"
    ],
    "icon": "assets/tray-icon.png"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
